# ── Thaakat env ── copy to .env.local and fill in. NEVER commit real keys. Synthetic data only.
#
# DELETE ANY LINE YOU DON'T FILL IN. Next loads .env.local OVER .env, so a blank value here
# shadows a real key with an empty string — and Moss, Stedi and Medplum each fall back to their
# offline stubs without erroring, so the app looks fine while no sponsor call is being made.

# Deepgram (voice) — get $200 free credit at https://console.deepgram.com/signup
# Server-only. The browser gets a short-lived token minted by /api/deepgram/token.
# Needs the "Member" role or higher, or /v1/auth/grant 403s and the route falls back to
# handing the raw key to the browser (demo-only). See docs/VOICE_AGENT.md.
DEEPGRAM_API_KEY=

# Anthropic (Claude — the "think" model). Used by Deepgram Voice Agent (BYO) and/or Medplum bots.
ANTHROPIC_API_KEY=

# Moss (real-time retrieval) — sign up at https://moss.dev , free tier
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=

# Medplum (FHIR + bots) — hosted project at https://app.medplum.com
# Create a ClientApplication at https://app.medplum.com/admin/clients
NEXT_PUBLIC_MEDPLUM_BASE_URL=https://api.medplum.com/
MEDPLUM_CLIENT_ID=
MEDPLUM_CLIENT_SECRET=

# Stedi (eligibility) — free sandbox at https://stedi.com/create-sandbox , generate a TEST key
STEDI_API_KEY=
